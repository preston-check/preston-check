# Preston-Check — local artifacts and operator-only files

# Cycle output and reports (per-run scan artifacts)
cycles/
*.report.md
*.report.pdf
preston-check-report.md
preston-check-report.pdf
security-audit-*.md
security-audit-*.pdf

# License files (signed customer licenses, never commit)
*.license
~/.preston-check/

# OS / editor
.DS_Store
*.swp
*.swo
.idea/
.vscode/

# Build artifacts and tmp
/tmp/
*.tmp
node_modules/
dist/
build/

# Secrets / private keys (never commit any private signing material)
*.pem.private
*-private.pem
keys/private*

# Private project configs (kept locally, never committed)
configs/bloxcross.yml
configs/operations.yml
configs/robbie.yml

# Bloxcross-branded assets (project is now Preston-Check standalone)
blox-logo.png
blox-logo-white.svg
blox-logo*.svg
blox-logo*.png

# Internal cycle output / private working files
cycles/

# Operator-only docx sources of public PDFs (review before tracking publicly)
Preston-Check_Selling_Sheet.docx
Preston-Check_Whitepaper.docx
Preston-Check_Whitepaper-full_info.docx
.claude/

# Wrangler local cache (created when wrangler runs locally during
# Cloudflare resource provisioning). Account metadata only, not secrets.
.wrangler/

# Threat-intel pipeline runtime state. Default-deny everything, then
# explicitly allow the paths the workflows commit for state persistence
# across runs (state/, drift/, telemetry-feedback/, correlated.json).
.preston-check/*
!.preston-check/state/
!.preston-check/drift/
!.preston-check/telemetry-feedback/
!.preston-check/correlated.json
!.preston-check/orchestrate-summary.json
corpus/snapshots/

# Python local-test virtual envs and caches
.venv/
venv/
__pycache__/
*.pyc

# Claude Code session-local memory artifacts (real memory lives in ~/.claude/)
MEMORY.md
memory/
