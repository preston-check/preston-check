  "_frontend_note": [
    "Pages are served from the layout the deploy workflow actually publishes,",
    "not from the source tree. admin and customer are staged into an out/ dir",
    "with index.html at the root and shared art under landing/assets \u2014 so the",
    "relative '../landing/assets/x.svg' in their markup clamps to",
    "'/landing/assets/x.svg' exactly as it does in production. Serving the",
    "source tree instead makes those assets 404 in the test and pass in prod,",
    "which is the wrong way round for a gate.",
    "",
    "The `stage` lists mirror the cp lines in the deploy workflows; drift-check",
    "compares them and fails if they diverge."
  ],
  "frontend_apps": {
    "landing": {
      "workflow": "pages.yml",
      "root": "web/landing",
      "stage": null
    },
    "admin": {
      "workflow": "admin-pages.yml",
      "stage": [
        [
          "web/admin/index.html",
          "index.html"
        ],
        [
          "web/admin/styles.css",
          "styles.css"
        ],
        [
          "web/admin/app.js",
          "app.js"
        ],
        [
          "web/admin/README.md",
          "README.md"
        ],
        [
          "web/landing/icons",
          "landing/icons"
        ],
        [
          "web/landing/assets",
          "landing/assets"
        ]
      ]
    },
    "customer": {
      "workflow": "customer-pages.yml",
      "stage": [
        [
          "web/customer/index.html",
          "index.html"
        ],
        [
          "web/customer/styles.css",
          "styles.css"
        ],
        [
          "web/customer/app.js",
          "app.js"
        ],
        [
          "web/customer/README.md",
          "README.md"
        ],
        [
          "web/landing/icons",
          "landing/icons"
        ],
        [
          "web/landing/assets",
          "landing/assets"
        ]
      ]
    }
  },
